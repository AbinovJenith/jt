# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/jothi_traders?schema=public"

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET="change_this_to_a_secure_random_string_min_32_chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change_this_to_another_secure_random_string"
JWT_REFRESH_EXPIRES_IN="7d"

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=4000
API_PREFIX=api/v1
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ── Object Storage ────────────────────────────────────────────────────────────
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=jothi-traders
R2_PUBLIC_URL=https://your-bucket.your-domain.com

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXTAUTH_SECRET="change_this_nextauth_secret"
NEXTAUTH_URL=http://localhost:3000
