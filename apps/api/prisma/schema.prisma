// ─────────────────────────────────────────────────────────────────────────────
// Jothi Traders – Prisma Schema
// Generic B2B Trading Platform
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ══════════════════════════════════════════════════════════════════════════════
// ENUMS
// ══════════════════════════════════════════════════════════════════════════════

enum UserRole {
  ADMIN
  STAFF
  SUPPLIER
  CUSTOMER
}

enum AttributeType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTI_SELECT
  DATE
}

enum DocumentType {
  DATASHEET
  SAFETY_SHEET
  CERTIFICATE
  MANUAL
  BROCHURE
  OTHER
}

enum RFQStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  QUOTED
  EXPIRED
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  REVISED
}

enum OrderStatus {
  CONFIRMED
  PROCESSING
  PARTIALLY_SHIPPED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum InvoiceStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CHEQUE
  CASH
  UPI
  CREDIT_CARD
  ONLINE
}

enum ShipmentStatus {
  PREPARING
  DISPATCHED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
}

// ══════════════════════════════════════════════════════════════════════════════
// AUTH & USERS
// ══════════════════════════════════════════════════════════════════════════════

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole @default(STAFF)
  phone        String?
  avatarUrl    String?
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ══════════════════════════════════════════════════════════════════════════════
// PRODUCT CATALOGUE
// ══════════════════════════════════════════════════════════════════════════════

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  attributeGroups AttributeGroup[]
  products        Product[]

  @@index([parentId])
  @@index([slug])
  @@map("categories")
}

model AttributeGroup {
  id         String   @id @default(cuid())
  name       String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  attributes AttributeDefinition[]

  @@index([categoryId])
  @@map("attribute_groups")
}

model AttributeDefinition {
  id           String         @id @default(cuid())
  groupId      String
  group        AttributeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name         String
  slug         String
  type         AttributeType
  unit         String?
  options      String[]       // For SELECT / MULTI_SELECT
  isRequired   Boolean        @default(false)
  isFilterable Boolean        @default(false)
  isSortable   Boolean        @default(false)
  sortOrder    Int            @default(0)
  createdAt    DateTime       @default(now())

  values ProductAttributeValue[]

  @@unique([groupId, slug])
  @@index([groupId])
  @@map("attribute_definitions")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants  ProductVariant[]
  images    ProductImage[]
  documents ProductDocument[]

  @@index([categoryId])
  @@index([slug])
  @@map("products")
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String   @unique
  name      String
  barcode   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attributes      ProductAttributeValue[]
  supplierProducts SupplierProduct[]
  inventoryItems  InventoryItem[]
  rfqItems        RFQItem[]
  quotationItems  QuotationItem[]
  orderItems      OrderItem[]
  poItems         PurchaseOrderItem[]

  @@index([productId])
  @@index([sku])
  @@map("product_variants")
}

model ProductAttributeValue {
  id          String              @id @default(cuid())
  variantId   String
  variant     ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   AttributeDefinition @relation(fields: [attributeId], references: [id])
  value       String

  @@unique([variantId, attributeId])
  @@index([variantId])
  @@map("product_attribute_values")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  key       String   // Storage key for deletion
  altText   String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

model ProductDocument {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  type      DocumentType
  url       String
  key       String       // Storage key for deletion
  fileSize  Int?
  mimeType  String?
  createdAt DateTime     @default(now())

  @@index([productId])
  @@map("product_documents")
}

// ══════════════════════════════════════════════════════════════════════════════
// SUPPLIERS
// ══════════════════════════════════════════════════════════════════════════════

model Supplier {
  id          String   @id @default(cuid())
  companyName String
  contactName String?
  email       String   @unique
  phone       String?
  address     Json?    // { street, city, state, pincode, country }
  gstNumber   String?
  panNumber   String?
  bankDetails Json?    // { bankName, accountNumber, ifscCode, accountName }
  isActive    Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products       SupplierProduct[]
  purchaseOrders PurchaseOrder[]

  @@index([email])
  @@map("suppliers")
}

model SupplierProduct {
  id           String         @id @default(cuid())
  supplierId   String
  supplier     Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  basePrice    Decimal        @db.Decimal(12, 2)
  currency     String         @default("INR")
  minOrderQty  Int            @default(1)
  leadTimeDays Int?
  isAvailable  Boolean        @default(true)
  notes        String?
  updatedAt    DateTime       @updatedAt

  @@unique([supplierId, variantId])
  @@index([supplierId])
  @@index([variantId])
  @@map("supplier_products")
}

// ══════════════════════════════════════════════════════════════════════════════
// CUSTOMERS
// ══════════════════════════════════════════════════════════════════════════════

model Customer {
  id          String   @id @default(cuid())
  companyName String
  contactName String?
  email       String   @unique
  phone       String?
  address     Json?    // { street, city, state, pincode, country }
  gstNumber   String?
  panNumber   String?
  creditLimit Decimal? @db.Decimal(12, 2)
  creditTerms Int?     // payment terms in days
  isActive    Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rfqs   RFQ[]
  orders Order[]

  @@index([email])
  @@map("customers")
}

// ══════════════════════════════════════════════════════════════════════════════
// INVENTORY
// ══════════════════════════════════════════════════════════════════════════════

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  inventory InventoryItem[]

  @@map("warehouses")
}

model InventoryItem {
  id           String         @id @default(cuid())
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  warehouseId  String
  warehouse    Warehouse      @relation(fields: [warehouseId], references: [id])
  qtyOnHand    Int            @default(0)
  qtyReserved  Int            @default(0)
  reorderLevel Int?
  updatedAt    DateTime       @updatedAt

  @@unique([variantId, warehouseId])
  @@index([variantId])
  @@index([warehouseId])
  @@map("inventory_items")
}

// ══════════════════════════════════════════════════════════════════════════════
// RFQ → QUOTATION → ORDER WORKFLOW
// ══════════════════════════════════════════════════════════════════════════════

model RFQ {
  id         String    @id @default(cuid())
  rfqNumber  String    @unique
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  status     RFQStatus @default(DRAFT)
  notes      String?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  items      RFQItem[]
  quotations Quotation[]

  @@index([customerId])
  @@index([status])
  @@map("rfqs")
}

model RFQItem {
  id        String         @id @default(cuid())
  rfqId     String
  rfq       RFQ            @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  qty       Int
  notes     String?

  quotationItems QuotationItem[]

  @@index([rfqId])
  @@map("rfq_items")
}

model Quotation {
  id              String          @id @default(cuid())
  quotationNumber String          @unique
  rfqId           String
  rfq             RFQ             @relation(fields: [rfqId], references: [id])
  status          QuotationStatus @default(DRAFT)
  validUntil      DateTime
  notes           String?
  termsConditions String?
  totalAmount     Decimal         @db.Decimal(12, 2) @default(0)
  taxAmount       Decimal         @db.Decimal(12, 2) @default(0)
  currency        String          @default("INR")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  items  QuotationItem[]
  orders Order[]

  @@index([rfqId])
  @@index([status])
  @@map("quotations")
}

model QuotationItem {
  id          String         @id @default(cuid())
  quotationId String
  quotation   Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  rfqItemId   String?
  rfqItem     RFQItem?       @relation(fields: [rfqItemId], references: [id])
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  qty         Int
  unitPrice   Decimal        @db.Decimal(12, 2)
  discount    Decimal        @db.Decimal(5, 2) @default(0)
  gstRate     Decimal        @db.Decimal(5, 2) @default(18)
  totalPrice  Decimal        @db.Decimal(12, 2)
  notes       String?

  @@index([quotationId])
  @@map("quotation_items")
}

model Order {
  id               String      @id @default(cuid())
  orderNumber      String      @unique
  customerId       String
  customer         Customer    @relation(fields: [customerId], references: [id])
  quotationId      String?
  quotation        Quotation?  @relation(fields: [quotationId], references: [id])
  status           OrderStatus @default(CONFIRMED)
  totalAmount      Decimal     @db.Decimal(12, 2)
  taxAmount        Decimal     @db.Decimal(12, 2) @default(0)
  notes            String?
  deliveryAddress  Json?
  expectedDelivery DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  items          OrderItem[]
  purchaseOrders PurchaseOrder[]
  invoices       Invoice[]
  shipments      Shipment[]

  @@index([customerId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id         String         @id @default(cuid())
  orderId    String
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  qty        Int
  unitPrice  Decimal        @db.Decimal(12, 2)
  discount   Decimal        @db.Decimal(5, 2) @default(0)
  gstRate    Decimal        @db.Decimal(5, 2) @default(18)
  totalPrice Decimal        @db.Decimal(12, 2)

  @@index([orderId])
  @@map("order_items")
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  poNumber     String              @unique
  supplierId   String
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  orderId      String?
  order        Order?              @relation(fields: [orderId], references: [id])
  status       PurchaseOrderStatus @default(DRAFT)
  totalAmount  Decimal             @db.Decimal(12, 2)
  expectedDate DateTime?
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  items PurchaseOrderItem[]

  @@index([supplierId])
  @@index([orderId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id          String         @id @default(cuid())
  poId        String
  po          PurchaseOrder  @relation(fields: [poId], references: [id], onDelete: Cascade)
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  qty         Int
  unitPrice   Decimal        @db.Decimal(12, 2)
  totalPrice  Decimal        @db.Decimal(12, 2)
  qtyReceived Int            @default(0)

  @@index([poId])
  @@map("purchase_order_items")
}

// ══════════════════════════════════════════════════════════════════════════════
// FINANCE
// ══════════════════════════════════════════════════════════════════════════════

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id])
  status        InvoiceStatus @default(PENDING)
  amount        Decimal       @db.Decimal(12, 2)
  taxAmount     Decimal       @db.Decimal(12, 2) @default(0)
  totalAmount   Decimal       @db.Decimal(12, 2)
  dueDate       DateTime
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  payments Payment[]

  @@index([orderId])
  @@index([status])
  @@map("invoices")
}

model Payment {
  id        String        @id @default(cuid())
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id])
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod
  reference String?
  notes     String?
  paidAt    DateTime      @default(now())
  createdAt DateTime      @default(now())

  @@index([invoiceId])
  @@map("payments")
}

model Shipment {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id])
  trackingNumber String?
  carrier        String?
  status         ShipmentStatus @default(PREPARING)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([orderId])
  @@map("shipments")
}

// ══════════════════════════════════════════════════════════════════════════════
// AUDIT
// ══════════════════════════════════════════════════════════════════════════════

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String   // CREATE | UPDATE | DELETE | LOGIN | LOGOUT | STATUS_CHANGE
  resource   String   // e.g. "Order", "RFQ", "Product"
  resourceId String?
  oldData    Json?
  newData    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ══════════════════════════════════════════════════════════════════════════════
// SEQUENCE COUNTERS (for human-readable numbers)
// ══════════════════════════════════════════════════════════════════════════════

model SequenceCounter {
  name    String @id // e.g. "RFQ", "QUO", "ORD", "PO", "INV"
  current Int    @default(0)

  @@map("sequence_counters")
}
